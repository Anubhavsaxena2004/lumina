# Server Environment Variables
NODE_ENV=development
PORT=4000

# Database Configuration (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=kumkum_payal
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/kumkum_payal

# Cache & Message Broker (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# JWT & Authentication
JWT_SECRET=super-secret-jwt-key-kumkum-2026
JWT_REFRESH_SECRET=super-secret-refresh-key-kumkum-2026
JWT_EXPIRATION_TIME=15m
JWT_REFRESH_EXPIRATION_TIME=7d

# WhatsApp Cloud API (set to 'mock' for local dev and tests)
WHATSAPP_PROVIDER=mock
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=kumkum-verify-token
WHATSAPP_API_VERSION=v19.0

# Storage (local or s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# Reminder Scheduler
REMINDER_SEND_TIME=10:00
TIMEZONE=Asia/Kolkata

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000
NEXT_PUBLIC_USE_MOCK=false
CORS_ORIGIN=http://localhost:3000
